{
  "name": "tennisdb",
  "private": true,
  "version": "0.991.0",
  "description": "Personal tennis equipment database: strings, hybrids, gut pairings, grips and a stringing log.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
