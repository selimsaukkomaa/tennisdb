{
  "name": "tennisdb",
  "private": true,
  "version": "0.993.0",
  "description": "Personal tennis equipment database: strings, hybrids, gut pairings, grips and a stringing log.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate": "tsx scripts/validate-data.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "check": "npm run validate && npm run typecheck && npm run lint && prettier --check . && npm test && npm run test:visual",
    "extract": "tsx scripts/extract-legacy.ts",
    "fonts:vendor": "tsx scripts/vendor-fonts.ts",
    "build:ios": "vite build && cap sync ios",
    "ios:open": "cap open ios",
    "icons": "tsx scripts/make-icons.ts blue"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  }
}
