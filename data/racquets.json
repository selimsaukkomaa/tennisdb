  {
    "id": "percept",
    "brand": "Yonex",
    "model": "Percept 100D",
    "headSizeSqIn": 100,
    "pattern": {
      "mains": 18,
      "crosses": 19
    },
    "ra": 66,
    "profile": {
      "edition": "The 2023 original.",
      "summary": "Box-beam 100 (23 mm) with a dense 18×19 pattern. Servo Filter film and FlexCon in the shaft add flex and filter vibration; extra graphite in the hoop firms the face. Contact is crisp and solid, launch low and the ball flat; power stays modest and control high.",
      "construction": [
        {
          "name": "2G-Namd",
          "text": "High-modulus graphite with 2G-Namd, as Yonex lists the layup.",
          "sources": [
            "tennisnerd-2023"
          ]
        },
        {
          "name": "Servo Filter",
          "text": "A film between the graphite layers of the shaft; adds flex and filters vibration.",
          "sources": [
            "tw-2023",
            "tenniscom-2024"
          ]
        },
        {
          "name": "FlexCon",
          "text": "A tapered, elongated box-beam shaft that flexes at contact to pocket the ball.",
          "sources": [
            "tenniscom-2024"
          ]
        },
        {
          "name": "Stiffer face",
          "text": "Extra graphite in the hoop for a firmer face.",
          "sources": [
            "tenniscom-2024"
          ]
        },
        {
          "name": "Isometric head",
          "text": "A squared head that widens the hitting zone near the top.",
          "sources": [
            "tennisnerd-2023"
          ]
        }
      ],
      "specs": {
        "strungWeightG": 320,
        "balancePtsHL": 6,
        "swingweight": 318,
        "beamMm": [
          23
        ],
        "sources": [
          "tw-2023",
          "tennisnerd-2023"
        ]
      },
      "traits": {
        "feel": {
          "word": "crisp",
          "basis": "Crisp, solid contact; harsher off-centre.",
          "sources": [
            "tenniscom-2024",
            "tw-2023"
          ]
        },
        "power": {
          "word": "low-medium",
          "basis": "Modest free power; the swing supplies the pace, though the frame gives more than other 18×19 frames.",
          "sources": [
            "tw-2023",
            "tennisnerd-2023"
          ]
        },
        "launch": {
          "word": "low",
          "basis": "A low launch and a flat ball.",
          "sources": [
            "tw-2023",
            "tennisnerd-2023"
          ]
        },
        "spin": {
          "word": "medium",
          "basis": "Respectable topspin rather than high; the frame leans to flat drives.",
          "sources": [
            "tenniscom-2024",
            "tw-2023",
            "tennisnerd-2023"
          ]
        },
        "stability": {
          "word": "medium",
          "basis": "Solid on centre; off-centre the ball leaves the strings quickly.",
          "sources": [
            "tw-2023",
            "tenniscom-2024"
          ]
        },
        "comfort": {
          "word": "medium",
          "basis": "Arm-friendly on clean hits, harsh on mis-hits.",
          "sources": [
            "tw-2023",
            "tenniscom-2024"
          ]
        },
        "control": {
          "word": "high",
          "basis": "Predictable placement; control is where the frame stands out.",
          "sources": [
            "tw-2023",
            "tenniscom-2024",
            "tennisnerd-2023"
          ]
        }
      },
      "sources": [
