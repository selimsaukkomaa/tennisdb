            "improving-tennis-2019-info",
            "tennis-torasan-2022"
          ]
        },
        {
          "name": "Sleeve carbon",
          "text": "Densely woven carbon at the shaft that twists and returns quickly.",
          "sources": [
            "improving-tennis-2019-info",
            "tennis-torasan-2022"
          ]
        },
        {
          "name": "Isometric head",
          "text": "A squarer face, with the sweet spot widening toward the throat.",
