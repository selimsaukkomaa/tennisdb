{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/TennisDb",
  "$defs": {
    "TennisDb": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{3}$"
        },
        "racquets": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Racquet"
          }
        },
        "brandsStrings": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Brand"
          }
        },
        "strings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/String"
          }
        },
        "hybrids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Hybrid"
          }
        },
        "pairings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pairing"
          }
        },
        "grips": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "wet",
                "dry",
                "replacement"
              ]
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Grip"
              }
            }
          }
        },
        "gutStrings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GutString"
          }
        },
        "gutHybrids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GutPairing"
          }
        }
      },
      "required": [
        "version",
        "racquets",
        "brandsStrings",
        "strings",
        "hybrids",
        "pairings",
        "grips",
        "gutStrings",
        "gutHybrids"
      ],
      "additionalProperties": false,
      "description": "The equipment database (data/*.json, assembled)."
    },
    "Racquet": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "brand": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "headSizeSqIn": {
          "type": "integer",
          "minimum": 80,
          "maximum": 140
        },
        "pattern": {
          "type": "object",
          "properties": {
            "mains": {
              "type": "integer",
              "minimum": 12,
              "maximum": 22
            },
            "crosses": {
              "type": "integer",
              "minimum": 14,
              "maximum": 24
            }
          },
          "required": [
            "mains",
            "crosses"
          ],
          "additionalProperties": false
        },
        "ra": {
          "type": "integer",
          "minimum": 40,
          "maximum": 80
        }
      },
      "required": [
        "id",
        "brand",
        "model",
        "headSizeSqIn",
        "pattern",
        "ra"
      ],
      "additionalProperties": false,
      "description": "Shown as \"<brand> <model>\" with the spec \"<ra> RA · <mains>×<crosses> · <n> sq in\"."
    },
    "Brand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "accent": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        }
      },
      "required": [
        "name",
        "accent"
      ],
      "additionalProperties": false
    },
    "String": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "string",
          "minLength": 1
        },
        "shapeAttr": {
          "type": "string",
          "pattern": "^(hexagonal|round|square|pentagonal|octagonal|twisted|heptagonal)(,(hexagonal|round|square|pentagonal|octagonal|twisted|heptagonal))*$",
          "description": "Comma-separated shape tokens matched by the Shape chips."
        },
        "feelAttr": {
          "type": "string",
          "pattern": "^(crisp|plush|lively)?(,(crisp|plush|lively))*$",
          "description": "Comma-separated stored feel tokens (crisp, plush, lively), possibly none. Firm and Soft come from the stiffness band."
        },
        "gauges": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "colors": {
          "type": "object",
          "properties": {
            "dots": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "hex": {
                    "type": "string",
                    "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "hex",
                  "name"
                ],
                "additionalProperties": false
              }
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "dots",
            "label"
          ],
          "additionalProperties": false
        },
        "stiffness": {
          "$ref": "#/$defs/Stiffness"
        },
        "power": {
          "$ref": "#/$defs/PowerRating"
        },
        "spin": {
          "$ref": "#/$defs/SpinRating"
        },
        "control": {
          "$ref": "#/$defs/ControlRating"
        },
        "comfort": {
          "$ref": "#/$defs/ComfortRating"
        },
        "feelTags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FeelTag"
          }
        },
        "feelSummary": {
          "type": "string",
          "minLength": 1
        },
        "feelExpand": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "brand": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      "required": [
        "name",
        "shape",
        "shapeAttr",
        "feelAttr",
        "gauges",
        "colors",
        "stiffness",
        "power",
        "spin",
        "control",
        "comfort",
        "feelTags",
        "feelSummary",
        "feelExpand",
        "id",
        "brand"
      ],
      "additionalProperties": false
    },
    "Stiffness": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "figure": {
              "$ref": "#/$defs/StiffnessFigure"
            }
          },
          "required": [
            "figure"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "band": {
              "type": "string",
              "enum": [
                "Very Soft",
                "Soft",
                "Med-Soft",
                "Medium",
                "Med-Firm",
                "Firm",
                "Very Firm"
              ]
            },
            "figure": {
              "type": "null"
            }
          },
          "required": [
            "band",
            "figure"
          ],
          "additionalProperties": false
        }
      ],
      "description": "A figure (the band is derived from it), or no figure and an estimated band."
    },
    "StiffnessFigure": {
      "type": "object",
      "properties": {
        "kgPerMm": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.2,
              "maximum": 2
            },
            {
              "type": "object",
              "properties": {
                "min": {
                  "type": "number",
                  "minimum": 0.2,
                  "maximum": 2
                },
                "max": {
                  "type": "number",
                  "minimum": 0.2,
                  "maximum": 2
                }
              },
              "required": [
                "min",
                "max"
              ],
              "additionalProperties": false
            }
          ]
        },
        "approx": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "enum": [
            "legacy",
            "Racketpedia",
            "manufacturer",
            "review"
          ]
        },
        "retrieved": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kgPerMm",
        "approx",
        "source",
        "retrieved"
      ],
      "additionalProperties": false
    },
    "PowerRating": {
      "type": "object",
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "label": {
          "type": "string",
          "enum": [
            "Low",
            "Low-Med",
            "Med-Low",
            "Medium",
            "Med-High",
            "High",
            "Very High"
          ]
        }
      },
      "required": [
        "score",
        "label"
      ],
      "additionalProperties": false,
      "description": "A score from 0 to 100 and a word from the list for its axis."
    },
    "SpinRating": {
      "type": "object",
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "label": {
          "type": "string",
          "enum": [
            "Low",
            "Low-Med",
            "Med-Low",
            "Medium",
            "Moderate",
            "Mod-High",
            "Med-High",
            "High",
            "High (Slice)",
            "Very High",
            "Elite"
          ]
        }
      },
      "required": [
        "score",
        "label"
      ],
      "additionalProperties": false,
      "description": "A score from 0 to 100 and a word from the list for its axis."
    },
    "ControlRating": {
      "type": "object",
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "label": {
          "type": "string",
          "enum": [
            "Low-Med",
            "Moderate",
            "Good",
            "Very Good",
            "Very High",
            "Excellent",
            "Outstanding"
          ]
        }
      },
      "required": [
        "score",
        "label"
      ],
      "additionalProperties": false,
      "description": "A score from 0 to 100 and a word from the list for its axis."
    },
    "ComfortRating": {
      "type": "object",
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "label": {
          "type": "string",
          "enum": [
            "Low",
            "Low-Mod",
            "Med-Low",
            "Moderate",
            "Medium",
            "Good",
            "Med-High",
            "Very Good",
            "High",
            "Very High",
            "Excellent",
            "Elite"
          ]
        }
      },
      "required": [
        "score",
        "label"
      ],
      "additionalProperties": false,
      "description": "A score from 0 to 100 and a word from the list for its axis."
    },
    "FeelTag": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "string",
          "enum": [
            "crisp",
            "firm",
            "soft",
            "round",
            "lively",
            "plush"
          ]
        }
      },
      "required": [
        "label",
        "variant"
      ],
      "additionalProperties": false
    },
    "Hybrid": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shapeAttr": {
          "type": "string",
          "pattern": "^(hexagonal|round|square|pentagonal|octagonal|twisted|heptagonal)(,(hexagonal|round|square|pentagonal|octagonal|twisted|heptagonal))*$",
          "description": "Comma-separated shape tokens matched by the Shape chips."
        },
        "feelAttr": {
          "type": "string",
          "pattern": "^(crisp|plush|lively)?(,(crisp|plush|lively))*$",
          "description": "Comma-separated stored feel tokens (crisp, plush, lively), possibly none. Firm and Soft come from the stiffness band."
        },
        "mains": {
          "type": "object",
          "properties": {
            "string": {
              "type": "string",
              "minLength": 1
            },
            "gauge": {
              "type": "string"
            },
            "shapeFeelLabel": {
              "type": "string",
              "minLength": 1
            },
            "stringId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The string this side uses; null when it is not in the data (Wasabi X)."
            }
          },
          "required": [
            "string",
            "gauge",
            "shapeFeelLabel",
            "stringId"
          ],
          "additionalProperties": false
        },
        "crosses": {
          "type": "object",
          "properties": {
            "string": {
              "type": "string",
              "minLength": 1
            },
            "gauge": {
              "type": "string"
            },
            "shapeFeelLabel": {
              "type": "string",
              "minLength": 1
            },
            "stringId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The string this side uses; null when it is not in the data (Wasabi X)."
            }
          },
          "required": [
            "string",
            "gauge",
            "shapeFeelLabel",
            "stringId"
          ],
          "additionalProperties": false
        },
        "stiffness": {
          "type": "object",
          "properties": {
            "band": {
              "type": "string",
              "enum": [
                "Very Soft",
                "Soft",
                "Med-Soft",
                "Medium",
                "Med-Firm",
                "Firm",
                "Very Firm"
              ]
            }
          },
          "required": [
            "band"
          ],
          "additionalProperties": false
        },
        "power": {
          "$ref": "#/$defs/PowerRating"
        },
        "spin": {
          "$ref": "#/$defs/SpinRating"
        },
        "feelTags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FeelTag"
          }
        },
        "feelSummary": {
          "type": "string",
          "minLength": 1
        },
        "feelExpand": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "brand": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      "required": [
        "name",
        "shapeAttr",
        "feelAttr",
        "mains",
        "crosses",
        "stiffness",
        "power",
        "spin",
        "feelTags",
        "feelSummary",
        "feelExpand",
        "id",
        "brand"
      ],
      "additionalProperties": false
    },
    "Pairing": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "itemId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "itemKind": {
              "type": "string",
              "const": "string"
            },
            "racquetId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "tension": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "range"
                    },
                    "minKg": {
                      "type": "number",
                      "minimum": 5,
                      "maximum": 40
                    },
                    "maxKg": {
                      "type": "number",
                      "minimum": 5,
                      "maximum": 40
                    }
                  },
                  "required": [
                    "kind",
                    "minKg",
                    "maxKg"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "max"
                    },
                    "maxKg": {
                      "type": "number",
                      "minimum": 5,
                      "maximum": 40
                    }
                  },
                  "required": [
                    "kind",
                    "maxKg"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "prestretch"
                    },
                    "kg": {
                      "type": "number",
                      "minimum": 5,
                      "maximum": 40
                    },
                    "prestretchPct": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 30
                    }
                  },
                  "required": [
                    "kind",
                    "kg",
                    "prestretchPct"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "itemId",
            "itemKind",
            "racquetId",
            "tension",
            "note"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "itemId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "itemKind": {
              "type": "string",
              "const": "hybrid"
            },
            "racquetId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "tension": {
              "$ref": "#/$defs/SplitTension"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "itemId",
            "itemKind",
            "racquetId",
            "tension",
            "note"
          ],
          "additionalProperties": false
        }
      ],
      "description": "How a string or hybrid is strung in one racquet."
    },
    "SplitTension": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "split"
        },
        "mainsKg": {
          "type": "number",
          "minimum": 5,
          "maximum": 40
        },
        "crossesKg": {
          "type": "number",
          "minimum": 5,
          "maximum": 40
        }
      },
      "required": [
        "kind",
        "mainsKg",
        "crossesKg"
      ],
      "additionalProperties": false,
      "description": "Mains / crosses, as in a hybrid or a gut pairing."
    },
    "Grip": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "modelVariants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "specs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GripSpec"
          }
        },
        "tackiness": {
          "$ref": "#/$defs/TackinessRating"
        },
        "absorption": {
          "$ref": "#/$defs/AbsorptionRating"
        },
        "durability": {
          "$ref": "#/$defs/DurabilityRating"
        },
        "feelTags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FeelTag"
          }
        },
        "feelSummary": {
          "type": "string",
          "minLength": 1
        },
        "feelExpand": {
          "type": "string",
          "minLength": 1
        },
        "colors": {
          "type": "string",
          "minLength": 1
        },
        "packSizes": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "gripType": {
          "type": "string",
          "enum": [
            "wet",
            "dry",
            "replacement"
          ]
        },
        "gripFeelAttr": {
          "type": "string",
          "pattern": "^([a-z]+(,[a-z]+)*)?$",
          "description": "Comma-separated feel tokens; the grip Feel chips match some."
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "material": {
          "type": "string",
          "minLength": 1
        },
        "materialVariant": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "model",
        "specs",
        "feelTags",
        "feelSummary",
        "feelExpand",
        "colors",
        "notes",
        "gripType",
        "gripFeelAttr",
        "id"
      ],
      "additionalProperties": false
    },
    "GripSpec": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "emphasis": {
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "emphasis"
      ],
      "additionalProperties": false,
      "description": "One line of the specs of a grip; emphasis draws it in amber."
    },
    "TackinessRating": {
      "type": "object",
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "label": {
          "type": "string",
          "enum": [
            "Low",
            "Low-Med",
            "Moderate",
            "High",
            "Very High",
            "Elite"
          ]
        }
      },
      "required": [
        "score",
        "label"
      ],
      "additionalProperties": false,
      "description": "A score from 0 to 100 and a word from the list for its axis."
    },
    "AbsorptionRating": {
      "type": "object",
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "label": {
          "type": "string",
          "enum": [
            "Low",
            "Med-Low",
            "Medium",
            "Moderate",
            "High",
            "Very High",
            "Excellent",
            "Elite"
          ]
        }
      },
      "required": [
        "score",
        "label"
      ],
      "additionalProperties": false,
      "description": "A score from 0 to 100 and a word from the list for its axis."
    },
    "DurabilityRating": {
      "type": "object",
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "label": {
          "type": "string",
          "enum": [
            "Low",
            "Moderate",
            "Medium",
            "Good",
            "Very Good",
            "Excellent"
          ]
        }
      },
      "required": [
        "score",
        "label"
      ],
