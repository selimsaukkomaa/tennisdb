{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/TennisDb",
  "$defs": {
    "TennisDb": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{3}$"
        },
        "racquets": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Racquet"
          }
        },
        "brandsStrings": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Brand"
          }
        },
        "strings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/String"
          }
        },
        "hybrids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Hybrid"
          }
        },
        "pairings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pairing"
          }
        },
        "grips": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "wet",
                "dry",
                "replacement"
              ]
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Grip"
              }
            }
          }
        },
        "gutStrings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GutString"
          }
        },
        "gutHybrids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GutPairing"
          }
        }
      },
      "required": [
        "version",
        "racquets",
        "brandsStrings",
        "strings",
        "hybrids",
        "pairings",
        "grips",
        "gutStrings",
        "gutHybrids"
      ],
      "additionalProperties": false,
      "description": "The equipment database (data/*.json, assembled)."
    },
    "Racquet": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "brand": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "headSizeSqIn": {
          "type": "integer",
          "minimum": 80,
          "maximum": 140
        },
        "pattern": {
          "type": "object",
          "properties": {
            "mains": {
              "type": "integer",
              "minimum": 12,
              "maximum": 22
            },
            "crosses": {
              "type": "integer",
              "minimum": 14,
              "maximum": 24
            }
          },
          "required": [
            "mains",
            "crosses"
          ],
          "additionalProperties": false
        },
        "ra": {
          "type": "integer",
          "minimum": 40,
          "maximum": 80
        },
        "profile": {
          "$ref": "#/$defs/FrameProfile"
        }
      },
      "required": [
        "id",
        "brand",
        "model",
        "headSizeSqIn",
        "pattern",
        "ra"
      ],
      "additionalProperties": false,
      "description": "Shown as \"<brand> <model>\" with the spec \"<ra> RA · <mains>×<crosses> · <n> sq in\"."
    },
    "FrameProfile": {
      "type": "object",
      "properties": {
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "construction": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                }
              }
            },
            "required": [
              "name",
              "text",
              "sources"
            ],
            "additionalProperties": false
          }
        },
        "specs": {
          "type": "object",
          "properties": {
            "strungWeightG": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 250,
                  "maximum": 400
                },
                {
                  "type": "null"
                }
              ]
            },
            "balancePtsHL": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": -10,
                  "maximum": 15
                },
                {
                  "type": "null"
                }
              ]
            },
            "swingweight": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 250,
                  "maximum": 380
                },
                {
                  "type": "null"
                }
              ]
            },
            "beamMm": {
              "anyOf": [
                {
                  "minItems": 1,
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 15,
                    "maximum": 35
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              }
            }
          },
          "required": [
            "strungWeightG",
            "balancePtsHL",
            "swingweight",
            "beamMm",
            "sources"
          ],
          "additionalProperties": false
        },
        "traits": {
          "type": "object",
          "properties": {
            "feel": {
              "type": "object",
              "properties": {
                "word": {
                  "type": "string",
                  "enum": [
                    "damped",
                    "neutral",
                    "crisp"
                  ]
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  }
                }
              },
              "required": [
                "word",
                "basis",
                "sources"
              ],
              "additionalProperties": false
            },
            "power": {
              "type": "object",
              "properties": {
                "word": {
                  "type": "string",
                  "enum": [
                    "low",
                    "low-medium",
                    "medium",
                    "medium-high",
                    "high"
                  ]
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  }
                }
              },
              "required": [
                "word",
                "basis",
                "sources"
              ],
              "additionalProperties": false
            },
            "launch": {
              "type": "object",
              "properties": {
                "word": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  }
                }
              },
              "required": [
                "word",
                "basis",
                "sources"
              ],
              "additionalProperties": false
            },
            "spin": {
              "type": "object",
              "properties": {
                "word": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  }
                }
              },
              "required": [
                "word",
                "basis",
                "sources"
              ],
              "additionalProperties": false
            },
            "stability": {
              "type": "object",
              "properties": {
                "word": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  }
                }
              },
              "required": [
                "word",
                "basis",
                "sources"
              ],
              "additionalProperties": false
            },
            "comfort": {
              "type": "object",
              "properties": {
                "word": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  }
                }
              },
              "required": [
                "word",
                "basis",
                "sources"
              ],
              "additionalProperties": false
            },
            "control": {
              "type": "object",
              "properties": {
                "word": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  }
                }
              },
              "required": [
                "word",
                "basis",
                "sources"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/FrameSource"
          }
        }
      },
      "required": [
        "edition",
        "summary",
        "construction",
        "specs",
        "traits",
        "sources"
      ],
      "additionalProperties": false,
      "description": "Construction, measured specs and character from published sources (since v1.12; frame.ts)."
    },
    "FrameSource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "review",
            "players",
            "article"
          ]
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
        },
        "url": {
          "type": "string",
          "pattern": "^https?:\\/\\/\\S+$"
        },
        "covers": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "publisher",
        "title",
        "date",
        "url"
      ],
      "additionalProperties": false
    },
    "Brand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "accent": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        }
      },
      "required": [
        "name",
        "accent"
      ],
      "additionalProperties": false
    },
    "String": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "string",
          "minLength": 1
        },
        "shapeAttr": {
          "type": "string",
          "pattern": "^(hexagonal|round|square|pentagonal|octagonal|twisted|heptagonal)(,(hexagonal|round|square|pentagonal|octagonal|twisted|heptagonal))*$",
          "description": "Comma-separated shape tokens matched by the Shape chips."
        },
        "feelAttr": {
          "type": "string",
          "pattern": "^(crisp|plush|lively)?(,(crisp|plush|lively))*$",
          "description": "Comma-separated stored feel tokens (crisp, plush, lively), possibly none. Firm and Soft come from the stiffness band."
        },
        "gauges": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "colors": {
          "type": "object",
          "properties": {
            "dots": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "hex": {
                    "type": "string",
                    "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "hex",
                  "name"
                ],
                "additionalProperties": false
              }
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "dots",
            "label"
          ],
          "additionalProperties": false
        },
        "stiffness": {
          "$ref": "#/$defs/Stiffness"
        },
        "power": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "The power score, 0-100; ratings.ts derives its word."
        },
        "spin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "The spin score, 0-100; ratings.ts derives its word."
        },
        "control": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "The control score, 0-100; ratings.ts derives its word."
        },
        "comfort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "The comfort score, 0-100; ratings.ts derives its word."
        },
        "feelTags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StringTag"
          }
        },
        "feelSummary": {
          "type": "string",
          "minLength": 1
        },
        "feelExpand": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "brand": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      "required": [
        "name",
        "shape",
        "shapeAttr",
        "feelAttr",
        "gauges",
        "colors",
        "stiffness",
        "power",
        "spin",
        "control",
        "comfort",
        "feelTags",
        "feelSummary",
        "feelExpand",
        "id",
        "brand"
      ],
      "additionalProperties": false
    },
    "Stiffness": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "figure": {
              "$ref": "#/$defs/StiffnessFigure"
            },
            "disputed": {
              "$ref": "#/$defs/DisputedReading"
            }
          },
          "required": [
            "figure"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "band": {
              "type": "string",
              "enum": [
                "Very Soft",
                "Soft",
                "Med-Soft",
                "Medium",
                "Med-Firm",
                "Firm",
                "Very Firm"
              ]
            },
            "figure": {
              "type": "null"
            },
            "disputed": {
              "$ref": "#/$defs/DisputedReading"
            }
          },
          "required": [
            "band",
            "figure"
          ],
          "additionalProperties": false
        }
      ],
      "description": "A figure (the band is derived from it), or no figure and an estimated band."
    },
    "StiffnessFigure": {
      "type": "object",
      "properties": {
        "kgPerMm": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.2,
              "maximum": 2
            },
            {
              "type": "object",
              "properties": {
                "min": {
                  "type": "number",
                  "minimum": 0.2,
                  "maximum": 2
                },
                "max": {
                  "type": "number",
                  "minimum": 0.2,
                  "maximum": 2
                }
              },
              "required": [
                "min",
                "max"
              ],
              "additionalProperties": false
            }
          ]
        },
        "approx": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "enum": [
            "legacy",
            "Racketpedia",
            "manufacturer",
            "review"
          ]
        },
        "retrieved": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            },
            {
              "type": "null"
            }
          ]
        },
        "pages": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "A racketpedia.com/en-GB/tennis-string/<page> slug."
          }
        }
      },
      "required": [
        "kgPerMm",
        "approx",
        "source",
        "retrieved"
      ],
      "additionalProperties": false
    },
    "DisputedReading": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "Racketpedia"
          ]
        },
        "kgPerMm": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 2
        },
        "pages": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "A racketpedia.com/en-GB/tennis-string/<page> slug."
          }
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        }
      },
      "required": [
        "source",
        "kgPerMm",
        "pages",
        "retrieved"
      ],
      "additionalProperties": false
    },
    "StringTag": {
      "type": "string",
      "enum": [
        "Crisp",
        "Firm",
        "Precise",
        "Controlled",
        "Aggressive",
        "Soft",
        "Softer",
        "Very Soft",
        "Moderate",
        "Muted",
        "Smooth",
        "Bite",
        "Lively",
        "Elastic",
        "Explosive",
        "Responsive",
        "Plush",
        "Pocketing",
        "Comfortable"
      ],
      "description": "A feel tag of a string or hybrid; tags.ts gives its colour."
    },
    "Hybrid": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shapeAttr": {
          "type": "string",
          "pattern": "^(hexagonal|round|square|pentagonal|octagonal|twisted|heptagonal)(,(hexagonal|round|square|pentagonal|octagonal|twisted|heptagonal))*$",
          "description": "Comma-separated shape tokens matched by the Shape chips."
        },
        "feelAttr": {
          "type": "string",
          "pattern": "^(crisp|plush|lively)?(,(crisp|plush|lively))*$",
          "description": "Comma-separated stored feel tokens (crisp, plush, lively), possibly none. Firm and Soft come from the stiffness band."
        },
        "mains": {
          "type": "object",
          "properties": {
            "string": {
              "type": "string",
              "minLength": 1
            },
            "gauge": {
              "type": "string"
            },
            "shapeFeelLabel": {
              "type": "string",
              "minLength": 1
            },
            "stringId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The string this side uses; null when it is not in the data (Wasabi X)."
            }
          },
          "required": [
            "string",
            "gauge",
            "shapeFeelLabel",
            "stringId"
          ],
          "additionalProperties": false
        },
        "crosses": {
          "type": "object",
          "properties": {
            "string": {
              "type": "string",
              "minLength": 1
            },
            "gauge": {
              "type": "string"
            },
            "shapeFeelLabel": {
              "type": "string",
              "minLength": 1
            },
            "stringId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The string this side uses; null when it is not in the data (Wasabi X)."
            }
          },
          "required": [
            "string",
            "gauge",
            "shapeFeelLabel",
            "stringId"
          ],
          "additionalProperties": false
        },
        "stiffness": {
          "type": "object",
          "properties": {
            "band": {
              "type": "string",
              "enum": [
                "Very Soft",
                "Soft",
                "Med-Soft",
                "Medium",
                "Med-Firm",
                "Firm",
                "Very Firm"
              ]
            }
          },
          "required": [
            "band"
          ],
          "additionalProperties": false
        },
        "power": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "The power score, 0-100; ratings.ts derives its word."
        },
        "spin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "The spin score, 0-100; ratings.ts derives its word."
        },
        "feelTags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StringTag"
          }
        },
        "feelSummary": {
          "type": "string",
          "minLength": 1
        },
        "feelExpand": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "brand": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      "required": [
        "name",
