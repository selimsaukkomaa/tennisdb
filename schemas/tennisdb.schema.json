{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/TennisDb",
  "$defs": {
    "TennisDb": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{3}$"
        },
        "racquets": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Racquet"
          }
        },
        "brandsStrings": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Brand"
          }
        },
        "strings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/String"
          }
        },
        "hybrids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Hybrid"
          }
        },
        "pairings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pairing"
          }
        },
        "grips": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "wet",
                "dry",
                "replacement"
              ]
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Grip"
              }
            }
          }
        },
        "gutStrings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GutString"
          }
        },
        "gutHybrids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GutPairing"
          }
        }
      },
      "required": [
        "version",
        "racquets",
        "brandsStrings",
        "strings",
        "hybrids",
        "pairings",
        "grips",
        "gutStrings",
        "gutHybrids"
      ],
      "additionalProperties": false,
      "description": "The equipment database (data/*.json, assembled)."
    },
    "Racquet": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "brand": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "headSize": {
          "type": "string",
          "pattern": "^\\d+ sq in$"
        },
        "pattern": {
          "type": "string",
          "pattern": "^\\d+×\\d+$"
        },
        "ra": {
          "type": "integer",
          "minimum": 40,
          "maximum": 80
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "brand",
        "model",
        "headSize",
        "pattern",
        "ra",
        "label"
      ],
      "additionalProperties": false
    },
    "Brand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "accent": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        }
      },
      "required": [
        "name",
        "accent"
      ],
      "additionalProperties": false
    },
    "String": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "string",
          "minLength": 1
        },
        "shapeAttr": {
          "type": "string",
          "pattern": "^(hexagonal|round|square|pentagonal|octagonal|twisted|heptagonal)(,(hexagonal|round|square|pentagonal|octagonal|twisted|heptagonal))*$",
          "description": "Comma-separated shape tokens matched by the Shape chips."
        },
        "feelAttr": {
          "type": "string",
          "pattern": "^(crisp|firm|soft|plush|lively)(,(crisp|firm|soft|plush|lively))*$",
          "description": "Comma-separated feel tokens matched by the Feel chips."
        },
        "gauges": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "colors": {
          "type": "object",
          "properties": {
            "dots": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "hex": {
                    "type": "string",
                    "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "hex",
                  "name"
                ],
                "additionalProperties": false
              }
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "dots",
            "label"
          ],
          "additionalProperties": false
        },
        "stiffness": {
          "$ref": "#/$defs/Bar"
        },
        "power": {
          "$ref": "#/$defs/Bar"
        },
        "spin": {
          "$ref": "#/$defs/Bar"
        },
        "control": {
          "$ref": "#/$defs/Bar"
        },
        "comfort": {
          "$ref": "#/$defs/Bar"
        },
        "feelTags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FeelTag"
          }
        },
        "feelSummary": {
          "type": "string",
          "minLength": 1
        },
        "feelExpand": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "brand": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      "required": [
        "name",
        "shape",
        "shapeAttr",
        "feelAttr",
        "gauges",
        "colors",
        "stiffness",
        "power",
        "spin",
        "control",
        "comfort",
        "feelTags",
        "feelSummary",
        "feelExpand",
        "id",
        "brand"
      ],
      "additionalProperties": false
    },
    "Bar": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "label",
        "width"
      ],
      "additionalProperties": false,
      "description": "A labelled bar; width is the fill percentage."
    },
    "FeelTag": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "string",
          "enum": [
            "crisp",
            "firm",
            "soft",
            "round",
            "lively",
            "plush"
          ]
        }
      },
      "required": [
        "label",
        "variant"
      ],
      "additionalProperties": false
    },
    "Hybrid": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shapeAttr": {
          "type": "string",
          "pattern": "^(hexagonal|round|square|pentagonal|octagonal|twisted|heptagonal)(,(hexagonal|round|square|pentagonal|octagonal|twisted|heptagonal))*$",
          "description": "Comma-separated shape tokens matched by the Shape chips."
        },
        "feelAttr": {
          "type": "string",
          "pattern": "^(crisp|firm|soft|plush|lively)(,(crisp|firm|soft|plush|lively))*$",
          "description": "Comma-separated feel tokens matched by the Feel chips."
        },
        "mains": {
          "type": "object",
          "properties": {
            "string": {
              "type": "string",
              "minLength": 1
            },
            "gauge": {
              "type": "string"
            },
            "shapeFeelLabel": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "string",
            "gauge",
            "shapeFeelLabel"
          ],
          "additionalProperties": false
        },
        "crosses": {
          "type": "object",
          "properties": {
            "string": {
              "type": "string",
              "minLength": 1
            },
            "gauge": {
              "type": "string"
            },
            "shapeFeelLabel": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "string",
            "gauge",
            "shapeFeelLabel"
          ],
          "additionalProperties": false
        },
        "stiffness": {
          "$ref": "#/$defs/Bar"
        },
        "power": {
          "$ref": "#/$defs/Bar"
        },
        "spin": {
          "$ref": "#/$defs/Bar"
        },
        "feelTags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FeelTag"
          }
        },
        "feelSummary": {
          "type": "string",
          "minLength": 1
        },
        "feelExpand": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "brand": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      "required": [
        "name",
        "shapeAttr",
        "feelAttr",
        "mains",
        "crosses",
        "stiffness",
        "power",
        "spin",
        "feelTags",
        "feelSummary",
        "feelExpand",
        "id",
        "brand"
      ],
      "additionalProperties": false
    },
    "Pairing": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "itemId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "itemKind": {
              "type": "string",
              "const": "string"
            },
            "racquetId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "tension": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "range"
                    },
                    "minKg": {
                      "type": "number",
                      "minimum": 5,
                      "maximum": 40
                    },
                    "maxKg": {
                      "type": "number",
                      "minimum": 5,
                      "maximum": 40
                    }
                  },
                  "required": [
                    "kind",
                    "minKg",
                    "maxKg"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "max"
                    },
                    "maxKg": {
                      "type": "number",
                      "minimum": 5,
                      "maximum": 40
                    }
                  },
                  "required": [
                    "kind",
                    "maxKg"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "prestretch"
                    },
                    "kg": {
                      "type": "number",
                      "minimum": 5,
                      "maximum": 40
                    },
                    "prestretchPct": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 30
                    }
                  },
                  "required": [
                    "kind",
                    "kg",
                    "prestretchPct"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "itemId",
            "itemKind",
            "racquetId",
            "tension",
            "note"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "itemId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "itemKind": {
              "type": "string",
              "const": "hybrid"
            },
            "racquetId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "tension": {
              "$ref": "#/$defs/SplitTension"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "itemId",
            "itemKind",
            "racquetId",
            "tension",
            "note"
          ],
          "additionalProperties": false
        }
      ],
      "description": "How a string or hybrid is strung in one racquet."
    },
    "SplitTension": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "split"
        },
        "mainsKg": {
          "type": "number",
          "minimum": 5,
          "maximum": 40
        },
        "crossesKg": {
          "type": "number",
          "minimum": 5,
          "maximum": 40
        }
      },
      "required": [
        "kind",
        "mainsKg",
        "crossesKg"
      ],
      "additionalProperties": false,
      "description": "Mains / crosses, as in a hybrid or a gut pairing."
    },
    "Grip": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "modelVariants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "specs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "May contain inline HTML (one <em> today)."
        },
        "tackiness": {
          "$ref": "#/$defs/Bar"
        },
        "absorption": {
          "$ref": "#/$defs/Bar"
        },
        "durability": {
          "$ref": "#/$defs/Bar"
        },
        "feelTags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FeelTag"
          }
        },
        "feelSummary": {
          "type": "string",
          "minLength": 1
        },
        "feelExpand": {
          "type": "string",
          "minLength": 1
        },
        "colors": {
          "type": "string",
          "minLength": 1
        },
        "packSizes": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "gripType": {
          "type": "string",
          "enum": [
            "wet",
            "dry",
            "replacement"
          ]
        },
        "gripFeelAttr": {
          "type": "string",
          "pattern": "^([a-z]+(,[a-z]+)*)?$",
          "description": "Comma-separated feel tokens; the grip Feel chips match some."
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "material": {
          "type": "string",
          "minLength": 1
        },
        "materialVariant": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "model",
        "specs",
        "feelTags",
        "feelSummary",
        "feelExpand",
        "colors",
        "notes",
        "gripType",
        "gripFeelAttr",
        "id"
      ],
      "additionalProperties": false
    },
    "GutString": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "brand": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "gauges": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "priceNote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "brand",
        "name",
        "gauges",
        "description",
        "priceNote"
      ],
      "additionalProperties": false
    },
    "GutPairing": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "racquetId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "config": {
          "type": "string",
          "enum": [
            "gut-mains",
            "gut-crosses"
          ]
        },
        "mains": {
          "type": "object",
          "properties": {
            "string": {
              "type": "string",
              "minLength": 1
            },
            "gauge": {
              "type": "string",
              "minLength": 1
            },
            "stringId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "required": [
            "string",
            "gauge",
            "stringId"
          ],
          "additionalProperties": false
        },
        "crosses": {
          "type": "object",
          "properties": {
            "string": {
              "type": "string",
              "minLength": 1
            },
            "gauge": {
              "type": "string",
              "minLength": 1
            },
            "stringId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "required": [
            "string",
            "gauge",
            "stringId"
          ],
          "additionalProperties": false
        },
        "feelLabel": {
          "type": "string",
          "minLength": 1
        },
        "power": {
          "$ref": "#/$defs/Bar"
        },
        "spin": {
          "$ref": "#/$defs/Bar"
        },
        "comfort": {
          "$ref": "#/$defs/Bar"
        },
        "gutProtection": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bar"
            },
            {
              "type": "null"
            }
          ]
        },
        "tension": {
          "$ref": "#/$defs/SplitTension"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "racquetId",
        "config",
        "mains",
        "crosses",
        "feelLabel",
        "power",
        "spin",
        "comfort",
        "gutProtection",
        "tension",
        "notes"
      ],
      "additionalProperties": false
    }
  }
}
