{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Copy",
  "$defs": {
    "Copy": {
      "type": "object",
      "properties": {
        "brandFooters": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "default": {
                "type": "string",
                "minLength": 1
              },
              "byRacquet": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "default"
            ],
            "additionalProperties": false
          }
        },
        "hybridCards": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1
              },
              "intro": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "heading",
              "intro"
            ],
            "additionalProperties": false
          }
        },
        "gripAbout": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "gutIntro": {
          "type": "string",
          "minLength": 1
        },
        "legends": {
          "type": "object",
          "properties": {
            "strings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "swatch": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "swatch",
                  "label"
                ],
                "additionalProperties": false
              }
            },
            "grips": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "swatch": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "swatch",
                  "label"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "strings",
            "grips"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "brandFooters",
        "hybridCards",
        "gripAbout",
        "gutIntro",
        "legends"
      ],
      "additionalProperties": false,
      "description": "Prose that lived in v0.990 markup or JS (HTML strings, verbatim)."
    }
  }
}
